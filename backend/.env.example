[TEMPLATE]
PORT=4010
MONGODB_URI=mongodb://127.0.0.1:27017/ai-governance
JWT_SECRET=change-me-in-production
# Set NODE_ENV=production on the host so the server refuses to start with the placeholder secret.
NODE_ENV=production
# Comma-separated list of allowed frontend origins for production, e.g.:
# CORS_ORIGINS=https://ai-governance.vercel.app
